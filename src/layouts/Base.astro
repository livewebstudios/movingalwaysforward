---
import '@fontsource-variable/archivo';
import '@fontsource/public-sans/400.css';
import '@fontsource/public-sans/600.css';
import '@fontsource/source-serif-4/400-italic.css';
import '../styles/global.css';
import archivoUrl from '@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url';
import publicSansUrl from '@fontsource/public-sans/files/public-sans-latin-400-normal.woff2?url';
import { ClientRouter } from 'astro:transitions';
import { getImage } from 'astro:assets';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FlagDefs from '../components/FlagDefs.astro';
import { site } from '../data/site';
import { organization, person, breadcrumbs, webPage, website, type Crumb } from '../lib/seo';
import logoFull from '../assets/brand/logo-full-2x.png';
import portrait from '../assets/photos/joe-portrait.png';

interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  crumbs?: Crumb[];
  schema?: Record<string, unknown>[];
  noIndex?: boolean;
  /** Omit the sitewide Person so a page can supply a richer one. */
  personOverride?: boolean;
  bodyClass?: string;
}

const {
  title,
  description,
  path,
  ogImage,
  ogType,
  crumbs = [],
  schema = [],
  noIndex = false,
  personOverride = false,
  bodyClass = '',
} = Astro.props;

const logo = await getImage({ src: logoFull, format: 'png' });
const portraitImg = await getImage({ src: portrait, width: 800, format: 'jpg' });
const logoAbs = new URL(logo.src, site.url).href;
const portraitAbs = new URL(portraitImg.src, site.url).href;

const graph: Record<string, unknown>[] = [
  website(),
  organization(logoAbs),
  ...(personOverride ? [] : [person(portraitAbs)]),
  webPage(path, title, description),
  ...(crumbs.length ? [breadcrumbs(crumbs)] : []),
  ...schema,
];
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo {title} {description} {path} {ogImage} {ogType} {noIndex} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Always Forward Insights" href="/insights/rss.xml" />
    <link rel="preload" as="font" type="font/woff2" href={archivoUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={publicSansUrl} crossorigin />
    <meta name="theme-color" content="#061A3A" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
    <script is:inline>
      // .js gates the reveal start states. Re-add it after every ClientRouter swap, which
      // replaces <html> attributes with the new page's (the class used to vanish after a click).
      document.documentElement.classList.add('js');
      // Netlify Identity invite and password links land on the home page; send them to the CMS.
      if (/(invite|recovery|confirmation|email_change)_token=/.test(location.hash)) {
        location.replace('/admin/' + location.hash);
      }
      if (!window.__afJs) {
        window.__afJs = true;
        document.addEventListener('astro:after-swap', function () {
          document.documentElement.classList.add('js');
        });
      }
    </script>
    <slot name="head" />

    <script type="application/ld+json" set:html={jsonLd} />

    <!-- Google Tag Manager (ID in src/data/site.ts). Official container snippet: the gtm.start
         event is what fires GTM's "All Pages" trigger. Async, so it never blocks the page. -->
    <script is:inline define:vars={{ gtm: site.gtm }}>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', gtm);
    </script>
  </head>
  <body class={bodyClass}>
    <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${site.gtm}`} height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>
    <a class="skip-link" href="#main">Skip to content</a>
    <FlagDefs />
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <script>
      // Reveal (motion kit #1): class toggle when 20% of the element enters the viewport, once.
      // Count-up (#9) for [data-count-to]. Pause all animation when the tab is hidden.
      const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Fallback for environments where IntersectionObserver is slow or silent: on scroll and after
      // a short timer, anything at or above the fold is revealed by measuring it directly.
      const revealVisible = () => {
        const pending = document.querySelectorAll<HTMLElement>('[data-reveal]:not(.is-in), [data-reveal-children]:not(.is-in)');
        if (!pending.length) return;
        const vh = window.innerHeight;
        pending.forEach((el) => {
          const r = el.getBoundingClientRect();
          if (r.top < vh * 0.95 && r.bottom > 0) el.classList.add('is-in');
        });
      };
      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          revealVisible();
          ticking = false;
        });
      };

      function setupReveal() {
        const els = document.querySelectorAll<HTMLElement>('[data-reveal]:not(.is-in), [data-reveal-children]:not(.is-in)');
        if (!els.length) return;
        if (!('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-in'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.2, rootMargin: '0px 0px -5% 0px' }
        );
        els.forEach((el) => io.observe(el));
        window.setTimeout(revealVisible, 900);
      }

      function setupCountUp() {
        const nums = document.querySelectorAll<HTMLElement>('[data-count-to]:not([data-counted])');
        if (!nums.length) return;
        const run = (el: HTMLElement) => {
          el.dataset.counted = '1';
          const to = Number(el.dataset.countTo);
          const prefix = el.dataset.countPrefix ?? '';
          const suffix = el.dataset.countSuffix ?? '';
          if (reduced() || Number.isNaN(to)) {
            el.textContent = `${prefix}${to}${suffix}`;
            return;
          }
          const start = performance.now();
          const dur = 900;
          const tick = (now: number) => {
            const p = Math.min(1, (now - start) / dur);
            const eased = 1 - Math.pow(1 - p, 3);
            el.textContent = `${prefix}${Math.round(to * eased)}${suffix}`;
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        };
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                run(e.target as HTMLElement);
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.5 }
        );
        nums.forEach((el) => io.observe(el));
      }

      function init() {
        setupReveal();
        setupCountUp();
      }
      document.addEventListener('astro:page-load', init);
      window.addEventListener('scroll', onScroll, { passive: true });
      document.addEventListener('visibilitychange', () => {
        document.documentElement.classList.toggle('page-hidden', document.visibilityState === 'hidden');
      });
    </script>
    <script>
      // Typed text, top to bottom, on the service pages' dash lists (.syllabus). No-op on other pages.
      import '../motion/syllabus-fx';
    </script>
  </body>
</html>
