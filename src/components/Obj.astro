---
// One of the nine brand objects (illustration layer). Decorative: alt="" and aria-hidden.
// Floats, tilts and parallaxes via CSS. Lives in margins and card corners, never in a text column.
import { Picture } from 'astro:assets';
import { objects, type ObjectName } from '../lib/images';

interface Props {
  name: ObjectName;
  /** rendered width in px at desktop */
  size: number;
  /** rendered width on phones; defaults to 60% of size */
  sizeMobile?: number;
  /** resting rotation in degrees */
  rotate?: number;
  depth?: 'far' | 'mid' | 'near' | 'none';
  float?: boolean;
  /** float phase index so neighbours never sync */
  phase?: number;
  eager?: boolean;
  class?: string;
}
const { name, size, sizeMobile, rotate = 0, depth = 'none', float = true, phase = 0, eager = false, class: cls = '' } = Astro.props;
const img = objects[name];
const mobile = sizeMobile ?? Math.round(size * 0.6);
const periods = [9, 11, 7.5, 10, 8, 9.5, 7, 10.5];
const ys = [-8, -10, -6, -9, -7, -8, -6, -10];
const rs = [1.5, -1.2, 1, -1.5, 1.2, -1, 1.4, -1.3];
const i = phase % periods.length;
const floatD = `${periods[i]}s`;
const floatY = `${ys[i]}px`;
const floatR = `${rs[i]}deg`;
const floatDelay = `${-(i * 1.7)}s`;
const sizeDesktop = `${size}px`;
const sizePhone = `${mobile}px`;
const rot = `${rotate}deg`;
---

<div class:list={['obj', depth !== 'none' && `px-${depth}`, cls]} aria-hidden="true">
  <div class:list={['obj__float', { float }]}>
    <Picture
      src={img}
      widths={[Math.min(480, size * 2), Math.min(480, Math.round(size * 1.25))]}
      sizes={`(max-width: 767px) ${mobile}px, ${size}px`}
      formats={['webp']}
      fallbackFormat="png"
      quality={82}
      alt=""
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      fetchpriority={eager ? 'high' : 'auto'}
      pictureAttributes={{ class: 'obj__pic' }}
      class="obj__img"
    />
  </div>
</div>

<style define:vars={{ sizeDesktop, sizePhone, rot, floatD, floatY, floatR, floatDelay }}>
  .obj {
    width: var(--sizePhone);
    aspect-ratio: 1;
    flex: none;
    pointer-events: none;
    transform: rotate(var(--rot));
    --float-d: var(--floatD);
    --float-y: var(--floatY);
    --float-r: var(--floatR);
    --float-delay: var(--floatDelay);
  }
  .obj__float,
  .obj :global(.obj__pic),
  .obj :global(.obj__img) {
    width: 100%;
    height: 100%;
  }
  .obj :global(.obj__img) {
    object-fit: contain;
  }
  @media (min-width: 768px) {
    .obj {
      width: var(--sizeDesktop);
    }
  }
</style>
