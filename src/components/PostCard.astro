---
// Insights post card: category pill, title, date, excerpt. No images; Insights is text-forward.
interface Props {
  title: string;
  href: string;
  date: Date;
  category: string;
  description: string;
}
const { title, href, date, category, description } = Astro.props;
const dateLabel = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<article class="post-card">
  <span class="pill pill--tint">{category}</span>
  <h3 class="post-card__title"><a href={href}>{title}</a></h3>
  <time class="post-card__date small" datetime={date.toISOString().slice(0, 10)}>{dateLabel}</time>
  <p class="post-card__excerpt">{description}</p>
</article>
