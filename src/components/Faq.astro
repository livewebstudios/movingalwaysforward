---
// FAQ accordion with native <details> (works with no JS). Pair with faqPage() JSON-LD on the page.
// Layout after Jon's reference (26_11_10): centered heading and contact line, divider rows with a
// plus that turns into an x, the open question outlined and its answer in a rounded mist panel.
// Every item starts closed, and only one is open at a time (opening one closes the others).
// The script below animates open and close (height, fade, blur). After livewebstudios.com/faq:
// each question decodes from random glyphs, left to right, when the list scrolls into view
// (staggered down the list), and an opened answer types in letter by letter behind a caret. The real
// text stays in the DOM throughout (glyph overlays are aria-hidden, typed words are opacity only).
// Reduced motion gets the plain native toggle and the text at once. No-JS: native <details>, kept exclusive by the
// shared `name` (the script drops `name` so it can animate the close itself).
import { site } from '../data/site';

interface Props {
  items: { q: string; a: string }[];
  heading?: string;
}
const { items, heading = 'Questions people ask first' } = Astro.props;
// one group name per FAQ block, for the no-JS exclusive accordion
const group = `faq-${Math.random().toString(36).slice(2, 8)}`;
---

<div class="faq" data-reveal>
  <div class="faq__head">
    <h3 class="faq__heading">{heading}</h3>
    <p class="faq__sub">
      Don't see yours? Ask Joe directly at <a href={`mailto:${site.email}`}>{site.email}</a>.
    </p>
  </div>
  <div class="faq__list">
    {
      items.map((f) => (
        <details class="faq__item" name={group}>
          <summary class="faq__q">
            <span>{f.q}</span>
            <svg aria-hidden="true" viewBox="0 0 20 20" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M10 4v12M4 10h12" /></svg>
          </summary>
          <div class="faq__a">
            <div class="faq__panel" set:html={f.a} />
          </div>
        </details>
      ))
    }
  </div>
</div>

<script>
  // Delegated click listener plus astro:page-load binding, so it keeps working across ClientRouter swaps.
  const EASE = 'cubic-bezier(0.22, 1, 0.36, 1)';
  const GLYPHS = '01<>/_#*+=:;[]{}';
  const DECODE_MS = 1400; // question decode, as on livewebstudios.com/faq
  const STAGGER_MS = 160; // between questions in one list
  const CHAR_MS = 10; // answer typewriter, per character
  const MAX_TYPE_MS = 1200; // longer answers type faster so none runs past this
  const TYPE_START_MS = 300; // let the panel open far enough to see the first letters land
  const CARET_LINGER_MS = 700; // caret blinks at the end a moment before the plain text returns
  const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const glyph = () => GLYPHS[(Math.random() * GLYPHS.length) | 0];

  // ---- questions: glyphs resolve into the text, left to right, once per page view ----
  function prepQuestions() {
    document.querySelectorAll<HTMLElement>('.faq__q > span:first-child:not([data-fx])').forEach((q) => {
      const text = (q.textContent ?? '').trim();
      if (!text) return;
      q.dataset.fx = 'pending';
      q.dataset.text = text;
      const real = document.createElement('span');
      real.className = 'faq-q-real';
      real.textContent = text;
      const glyphs = document.createElement('span');
      glyphs.className = 'faq-q-glyphs';
      glyphs.setAttribute('aria-hidden', 'true');
      q.textContent = '';
      q.append(real, glyphs);
    });
  }

  function decode(q: HTMLElement) {
    const text = q.dataset.text ?? '';
    const glyphs = q.querySelector<HTMLElement>('.faq-q-glyphs');
    const finish = () => {
      q.textContent = text; // back to the original plain markup
      q.classList.remove('is-decoding');
      q.dataset.fx = 'done';
    };
    if (!glyphs || !q.isConnected) return finish();
    q.dataset.fx = 'decoding';
    q.classList.add('is-decoding');
    let t0 = 0;
    const tick = (t: number) => {
      if (!t0) t0 = t;
      const k = Math.min(1, (t - t0) / DECODE_MS);
      const n = Math.floor(text.length * k);
      let tail = '';
      for (let i = n; i < text.length; i++) tail += text[i] === ' ' ? ' ' : glyph();
      glyphs.textContent = text.slice(0, n) + tail;
      if (k < 1) requestAnimationFrame(tick);
      else finish();
    };
    glyphs.textContent = text.replace(/\S/g, glyph);
    requestAnimationFrame(tick);
  }

  function decodeList(list: Element) {
    const qs = [...list.querySelectorAll<HTMLElement>('.faq__q > span[data-fx="pending"]')];
    qs.forEach((q, i) => {
      q.dataset.fx = 'queued';
      window.setTimeout(() => decode(q), i * STAGGER_MS);
    });
  }

  let io: IntersectionObserver | null = null;
  // Fallback for a slow or silent IntersectionObserver: measure lists already on screen.
  function decodeVisible() {
    const vh = window.innerHeight;
    document.querySelectorAll('.faq__list').forEach((list) => {
      if (!list.querySelector('.faq__q > span[data-fx="pending"]')) return;
      const r = list.getBoundingClientRect();
      if (r.top < vh * 0.9 && r.bottom > 0) decodeList(list);
    });
  }

  function init() {
    io?.disconnect();
    io = null;
    if (reduced()) return;
    prepQuestions();
    const lists = [...document.querySelectorAll('.faq__list')].filter((l) => l.querySelector('[data-fx="pending"]'));
    if (!lists.length) return;
    if (!('IntersectionObserver' in window)) return lists.forEach(decodeList);
    io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          decodeList(e.target);
          io?.unobserve(e.target);
        });
      },
      { threshold: 0.2 }
    );
    lists.forEach((l) => io!.observe(l));
    window.setTimeout(decodeVisible, 900);
  }

  // ---- answers: typewriter. Characters appear one at a time behind a blinking caret, each time an
  // item opens (Jon 2026-11-11). Characters are opacity-only spans inside no-wrap word spans, so the
  // panel never reflows while it types. A long answer speeds up so none takes more than MAX_TYPE_MS.
  const typeRuns = new WeakMap<HTMLElement, { raf: number; timer: number }>();

  function untype(panel: HTMLElement) {
    const run = typeRuns.get(panel);
    if (run) {
      cancelAnimationFrame(run.raf);
      window.clearTimeout(run.timer);
      typeRuns.delete(panel);
    }
    panel.querySelectorAll<HTMLElement>('[data-faq-w]').forEach((w) => w.replaceWith(w.textContent ?? ''));
    panel.normalize();
    panel.classList.remove('faq-typing');
  }

  function type(panel: HTMLElement) {
    untype(panel);
    const texts: Text[] = [];
    const walk = document.createTreeWalker(panel, NodeFilter.SHOW_TEXT);
    for (let n = walk.nextNode(); n; n = walk.nextNode()) texts.push(n as Text);
    texts.forEach((node) => {
      const frag = document.createDocumentFragment();
      (node.nodeValue ?? '').split(/(\s+)/).forEach((part) => {
        if (!part) return;
        if (/^\s+$/.test(part)) return void frag.appendChild(document.createTextNode(part));
        const w = document.createElement('span');
        w.className = 'faq-w';
        w.dataset.faqW = '';
        for (const ch of part) {
          const c = document.createElement('span');
          c.className = 'faq-c';
          c.textContent = ch;
          w.appendChild(c);
        }
        frag.appendChild(w);
      });
      node.replaceWith(frag);
    });
    const chars = [...panel.querySelectorAll<HTMLElement>('.faq-c')];
    if (!chars.length) return;
    const step = Math.min(CHAR_MS, MAX_TYPE_MS / chars.length);
    const t0 = performance.now() + TYPE_START_MS;
    let shown = 0;
    panel.classList.add('faq-typing');
    const run = { raf: 0, timer: 0 };
    typeRuns.set(panel, run);
    const frame = (now: number) => {
      const n = Math.min(chars.length, Math.max(0, Math.floor((now - t0) / step) + 1));
      if (n > shown) {
        chars[shown - 1]?.classList.remove('is-caret');
        for (; shown < n; shown++) chars[shown].classList.add('on');
        chars[n - 1].classList.add('is-caret');
      }
      if (shown < chars.length) run.raf = requestAnimationFrame(frame);
      else run.timer = window.setTimeout(() => untype(panel), CARET_LINGER_MS);
    };
    run.raf = requestAnimationFrame(frame);
  }

  // ---- open / close ----
  function open(item: HTMLDetailsElement, body: HTMLElement) {
    item.open = true;
    item.dataset.state = 'open';
    const panel = item.querySelector<HTMLElement>('.faq__panel');
    if (panel) type(panel);
    const h = body.scrollHeight;
    body.animate(
      [
        { height: '0px', opacity: 0, filter: 'blur(6px)', transform: 'translateY(-6px)' },
        { height: `${h}px`, opacity: 1, filter: 'blur(0)', transform: 'translateY(0)' },
      ],
      { duration: 420, easing: EASE }
    );
  }

  function close(item: HTMLDetailsElement, body: HTMLElement) {
    item.dataset.state = 'closing';
    const h = body.offsetHeight;
    const a = body.animate(
      [
        { height: `${h}px`, opacity: 1, filter: 'blur(0)', transform: 'translateY(0)' },
        { height: '0px', opacity: 0, filter: 'blur(4px)', transform: 'translateY(-4px)' },
      ],
      { duration: 300, easing: EASE }
    );
    // finish event plus a timer backup (a throttled background tab can hold the event back)
    let done = false;
    const finish = () => {
      if (done || item.dataset.state !== 'closing') return;
      done = true;
      item.open = false;
      delete item.dataset.state;
      const panel = item.querySelector<HTMLElement>('.faq__panel');
      if (panel) untype(panel);
    };
    a.onfinish = finish;
    window.setTimeout(finish, 340);
  }

  function toggle(item: HTMLDetailsElement) {
    const list = item.closest('.faq__list');
    // JS runs the exclusivity itself, so the native `name` group (no-JS fallback) is dropped first:
    // left on, the browser would snap the other item shut before its close animation could run.
    list?.querySelectorAll('details[name]').forEach((d) => d.removeAttribute('name'));
    const opening = !item.open || item.dataset.state === 'closing';
    const siblings = opening
      ? [...(list?.querySelectorAll<HTMLDetailsElement>('.faq__item[open]') ?? [])].filter(
          (d) => d !== item && d.dataset.state !== 'closing'
        )
      : [];
    const body = item.querySelector<HTMLElement>('.faq__a');

    if (!body || reduced() || !body.animate) {
      siblings.forEach((d) => (d.open = false));
      item.open = opening;
      return;
    }
    siblings.forEach((d) => {
      const b = d.querySelector<HTMLElement>('.faq__a');
      if (!b) return;
      b.getAnimations().forEach((a) => a.cancel());
      close(d, b);
    });
    body.getAnimations().forEach((a) => a.cancel());
    if (opening) open(item, body);
    else close(item, body);
  }

  document.addEventListener('click', (e) => {
    const summary = (e.target as Element | null)?.closest?.('.faq__q');
    if (!summary) return;
    const item = summary.parentElement as HTMLDetailsElement | null;
    if (!item || !item.classList.contains('faq__item')) return;
    e.preventDefault();
    toggle(item);
  });

  let ticking = false;
  window.addEventListener(
    'scroll',
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        decodeVisible();
      });
    },
    { passive: true }
  );
  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => {
    io?.disconnect();
    io = null;
  });
  // This module can first load during a ClientRouter swap, after that page's astro:page-load has
  // already fired; init is idempotent (data-fx guards), so run it now too.
  init();
</script>

<style>
  .faq {
    max-width: 760px;
    margin: var(--s-6) auto 0;
  }
  .faq__head {
    text-align: center;
    margin-bottom: var(--s-4);
  }
  .faq__heading {
    margin: 0 0 var(--s-2);
    font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .faq__sub {
    margin: 0 auto;
    max-width: 52ch;
    color: var(--ink-600);
    font-size: 1.0625rem;
  }
  .faq__sub a {
    color: var(--navy);
    text-decoration: underline;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }
  .faq__item {
    border-bottom: 1px solid var(--line);
    padding: 6px 0;
  }
  .faq__q {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-2);
    min-height: 56px;
    padding: 12px 16px;
    border: 1.5px solid transparent;
    border-radius: 12px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.125rem;
    color: var(--navy);
    cursor: pointer;
    list-style: none;
    transition:
      border-color 240ms var(--ease-out),
      background-color 240ms var(--ease-out),
      box-shadow 240ms var(--ease-out);
  }
  .faq__q::-webkit-details-marker {
    display: none;
  }
  .faq__q:hover {
    background: var(--mist);
  }
  .faq__q:focus-visible {
    outline: 2px solid var(--navy);
    outline-offset: 2px;
  }
  .faq__q svg {
    flex: none;
    color: var(--navy);
    transition: transform 420ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  /* open: outlined question, plus turns into an x */
  .faq__item[open]:not([data-state='closing']) .faq__q {
    border-color: var(--sky-200);
    background: var(--paper);
    box-shadow: 0 6px 18px -12px rgba(6, 26, 58, 0.35);
  }
  .faq__item[open]:not([data-state='closing']) .faq__q svg {
    transform: rotate(135deg);
  }
  .faq__a {
    overflow: hidden;
  }
  .faq__panel {
    margin: 8px 0 6px;
    padding: var(--s-2) var(--s-3);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--mist);
    color: var(--ink);
    line-height: 1.6;
  }
  /* question decode: the real text keeps its box, the glyphs ride an aria-hidden overlay */
  .faq__q > span {
    position: relative;
  }
  .faq__q > span[data-fx='pending'] :global(.faq-q-real),
  .faq__q > span[data-fx='queued'] :global(.faq-q-real),
  .faq__q > span.is-decoding :global(.faq-q-real) {
    opacity: 0;
  }
  .faq__q :global(.faq-q-glyphs) {
    position: absolute;
    inset: 0;
    /* glyphs run wider than letters; clip to the question's own box instead of spilling a line */
    overflow: hidden;
    color: var(--ink-600);
    pointer-events: none;
  }
  /* answer typewriter: characters are opacity-only spans in no-wrap words, so the panel never reflows */
  .faq__panel :global(.faq-w) {
    white-space: nowrap;
  }
  .faq__panel:global(.faq-typing) :global(.faq-c) {
    opacity: 0;
  }
  .faq__panel:global(.faq-typing) :global(.faq-c.on) {
    opacity: 1;
  }
  .faq__panel :global(.faq-c.is-caret) {
    position: relative;
  }
  .faq__panel :global(.faq-c.is-caret)::after {
    content: '';
    position: absolute;
    top: 0.12em;
    bottom: 0.06em;
    right: -3px;
    width: 2px;
    border-radius: 1px;
    background: var(--sky-600);
    animation: faq-caret 0.7s steps(1) infinite;
  }
  @keyframes faq-caret {
    50% {
      opacity: 0;
    }
  }
  .faq__panel :global(a) {
    color: var(--navy);
    font-weight: 600;
  }
  @media (prefers-reduced-motion: reduce) {
    .faq__q,
    .faq__q svg {
      transition: none;
    }
  }
</style>
