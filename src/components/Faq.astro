---
// FAQ accordion with native <details>. Pair with faqPage() JSON-LD on the page.
interface Props {
  items: { q: string; a: string }[];
  heading?: string;
}
const { items, heading = 'Questions people ask first' } = Astro.props;
---

<div class="faq" data-reveal>
  <h3 class="faq__heading">{heading}</h3>
  {
    items.map((f) => (
      <details class="faq__item">
        <summary class="faq__q">
          <span>{f.q}</span>
          <svg aria-hidden="true" viewBox="0 0 20 20" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M10 4v12M4 10h12" /></svg>
        </summary>
        <div class="faq__a" set:html={f.a} />
      </details>
    ))
  }
</div>

<style>
  .faq {
    max-width: 760px;
    margin-top: var(--s-4);
  }
  .faq__heading {
    margin-bottom: var(--s-2);
  }
  .faq__item {
    border-top: 1px solid var(--line);
  }
  .faq__item:last-of-type {
    border-bottom: 1px solid var(--line);
  }
  .faq__q {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-2);
    min-height: 56px;
    padding: 12px 4px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.125rem;
    color: var(--navy);
    cursor: pointer;
    list-style: none;
  }
  .faq__q::-webkit-details-marker {
    display: none;
  }
  .faq__q svg {
    flex: none;
    color: var(--sky);
    transition: transform 200ms var(--ease-out);
  }
  details[open] .faq__q svg {
    transform: rotate(45deg);
  }
  .faq__a {
    padding: 0 4px var(--s-3);
    max-width: 68ch;
    color: var(--ink);
  }
</style>
