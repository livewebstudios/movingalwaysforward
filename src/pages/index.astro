---
// Home · six sections, each with a job (docs/pages/home.md). No seventh.
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import Backdrop from '../components/Backdrop.astro';
import Obj from '../components/Obj.astro';
import CtaBand from '../components/CtaBand.astro';
import PostCard from '../components/PostCard.astro';
import Placeholder from '../components/Placeholder.astro';
import HeroStage from '../islands/HeroStage';
import DoorGrid, { type Door } from '../islands/DoorGrid';
import { objSrc, photoSrc } from '../lib/images';
import { site, bookInfo } from '../data/site';
import bgLight from '../assets/backgrounds/bg-contour-light.png';
import heroTeaching from '../assets/photos/joe-hero-teaching.png';
import oneOnOne from '../assets/photos/joe-one-on-one.png';

const title = 'Always Forward | Business & Career Coaching, Montvale NJ';
const description =
  'Business and career coaching from Joe Hliboki in Montvale, NJ. Early-career coaching for young professionals, executive coaching, and corporate training built like a course catalog.';

const [flag, compass, notebook, stones, plane, bubbles, ladder] = await Promise.all([
  objSrc('summit-flag', 280),
  objSrc('compass', 320),
  objSrc('notebook-pen', 400),
  objSrc('stepping-stones', 440),
  objSrc('paper-plane', 240),
  objSrc('speech-bubbles', 260),
  objSrc('ladder', 200),
]);
const heroPhoto = await photoSrc(heroTeaching, 'Joe Hliboki explaining a point to a small group of young professionals in a bright training room', [320, 640, 960]);
const doorObj = async (name: Parameters<typeof objSrc>[0]) => objSrc(name, 200);
const doors: Door[] = [
  {
    title: 'Early Career Coaching',
    href: '/early-career-coaching/',
    body: 'Starting a career is a skill, and nobody teaches it in school. Joe does. One-on-one coaching for Gen Z and young professionals, from the first resume to the first promotion. The only coaching on this site with a price on the page, because that is the point.',
    object: await doorObj('notebook-pen'),
    rotate: -8,
  },
  {
    title: 'Executive & Business Coaching',
    href: '/executive-business-coaching/',
    body: 'For professionals stuck one level below where they belong and owners who are the bottleneck in their own company. An honest assessment, a written plan with dates, and standing sessions that hold you to it.',
    object: await doorObj('compass'),
    rotate: 6,
  },
  {
    title: 'Corporate Training & Workshops',
    href: '/corporate-training/',
    body: 'Sales training, leadership development and communication workshops for teams, built like courses: what you get, how long it takes, what changes on Monday. Sold to HR and L&D leaders who have sat through enough motivational theater.',
    object: ladder,
    rotate: -5,
  },
  {
    title: 'Group Programs',
    href: '/group-programs/',
    body: 'Cohorts and teams that grow faster together. A defined group, a defined arc, homework, and the quiet power of saying what you will do in front of people who will ask about it.',
    object: await doorObj('speech-bubbles'),
    rotate: 9,
  },
];

const posts = (await getCollection('insights', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Base {title} {description} path="/">
  <HeroStage client:load objects={{ flag, compass, notebook, stones, plane, bubbles }} photo={heroPhoto}>
    <Fragment slot="backdrop">
      <Backdrop image={bgLight} eager parallax={false} />
    </Fragment>
    <span class="pill">Business & Career Coaching · Montvale, NJ</span>
    <h1 id="hero-title">Working to facilitate change and accelerate success.</h1>
    <p class="lede">
      Coaching from Joe Hliboki for the 23-year-old figuring out a first job, the leader building a team, and the company that wants both to get better at it.
    </p>
    <div class="hero__actions">
      <Button href="/contact/">Book a call with Joe</Button>
      <Button href="/early-career-coaching/" variant="secondary">See the coaching</Button>
    </div>
  </HeroStage>

  <!-- 2. The four doors -->
  <Section tone="mist" pitch id="doors" labelledby="doors-title">
    <div class="sec-head" data-reveal-children>
      <p class="eyebrow">Who this is for</p>
      <h2 id="doors-title">Four ways in. Pick yours.</h2>
      <p class="deck">Same coach. Different doors, because a new grad and an HR director are not shopping for the same thing.</p>
    </div>
    <DoorGrid client:visible {doors} />
  </Section>

  <!-- 3. Why Joe -->
  <Section id="why-joe" labelledby="why-title">
    <div class="why">
      <div class="why__photo photo-card px-mid" data-reveal>
        <Image src={oneOnOne} alt="Joe Hliboki listening across a table to a young professional during a coaching session" widths={[480, 720, 960]} sizes="(max-width: 1023px) 90vw, 520px" format="webp" quality={78} loading="lazy" decoding="async" />
      </div>
      <div class="why__copy" data-reveal-children>
        <p class="eyebrow">The coach</p>
        <h2 id="why-title">He ran the careers he now coaches.</h2>
        <p>
          Joe spent his corporate career at Cisco, where he led a healthcare sales team of sixteen to twenty people. Hiring, promoting, coaching through slumps, managing up, carrying the number. Every question he gets paid to answer now is one he lived first, with a quota attached.
        </p>
        <p>
          Along the way Cisco handed him its elite new-hire engineers to mentor. Twenty-two-year-olds, brilliant on paper, no idea how work actually works. He found he could get through to them fast. A mentor watched him do it and told him that the ability to earn a young person's trust in thirty minutes is rare, and it would be a waste not to build on it.
        </p>
        <p>Always Forward is what he built.</p>
        <dl class="facts">
          <div class="facts__item">
            <dt class="facts__num"><span data-count-to="20" data-count-prefix="16 to ">16 to 20</span></dt>
            <dd>direct reports at a Fortune 100</dd>
          </div>
          <div class="facts__item">
            <dt class="facts__num"><span data-count-to="500" data-count-suffix="+">500+</span></dt>
            <dd>Gen Z coached and mentored</dd>
          </div>
          <div class="facts__item">
            <dt class="facts__num"><span data-count-to="30" data-count-suffix=" min">30 min</span></dt>
            <dd>to earn trust, by one mentor's count</dd>
          </div>
        </dl>
        <Button href="/about/" variant="ghost">More about Joe</Button>
      </div>
    </div>
  </Section>

  <!-- 4. The book -->
  <Section tone="mist" pitch id="book" labelledby="book-title">
    <div class="bookband">
      <div class="bookband__visual" data-reveal>
        <div class="bookband__cover">
          <Placeholder text="BOOK COVER PLACEHOLDER: assets/source/book-cover.jpg, Jon supplies" block />
          <span class="bookband__cover-title" aria-hidden="true">{bookInfo.title}</span>
        </div>
        <div class="bookband__obj">
          <Obj name="notebook-pen" size={90} sizeMobile={70} rotate={-14} depth="near" float phase={4} />
        </div>
      </div>
      <div class="bookband__copy" data-reveal-children>
        <p class="eyebrow">The book</p>
        <h2 id="book-title">{bookInfo.title}</h2>
        <p class="deck">{bookInfo.subtitle}</p>
        <p>
          School hands you a diploma and a bubble: a comfortable set of assumptions about how work is going to work. The first job pops it. Joe wrote the handbook for that moment, in plain language, from everything he watched Fortune 100 new hires learn the hard way. How to show up, how to be managed, how to ask, how to recover, how to get noticed for the right reasons.
        </p>
        <div class="bookband__actions">
          <Button href="#amazon-url-placeholder" describedBy="amazon-ph">Get it on Amazon</Button>
          <Button href="/the-book/" variant="ghost">About the book</Button>
        </div>
        <p class="small" id="amazon-ph"><Placeholder text={site.amazon.replace(/[\[\]]/g, '')} /></p>
      </div>
    </div>
  </Section>

  <!-- 5. Latest Insights -->
  <Section id="latest" labelledby="latest-title">
    <div class="sec-head" data-reveal-children>
      <p class="eyebrow">Insights</p>
      <h2 id="latest-title">Plain talk on careers, leadership and work.</h2>
    </div>
    <div class="latest" data-reveal-children>
      {posts.map((p) => <PostCard title={p.data.title} href={`/insights/${p.id}/`} date={p.data.pubDate} category={p.data.category} description={p.data.description} />)}
    </div>
    <div class="latest__more">
      <Button href="/insights/" variant="ghost">All Insights</Button>
    </div>
  </Section>

  <!-- 6. Closing CTA -->
  <CtaBand
    heading="Momentum is a decision."
    body="One conversation to find out if coaching fits. Thirty minutes, no pitch, no pressure, and you leave with at least one thing to do differently tomorrow."
    button={{ label: 'Book a call with Joe', href: '/contact/' }}
  />
</Base>

<style>
  .sec-head {
    margin-bottom: var(--s-5);
    max-width: 760px;
  }
  .sec-head h2 {
    margin-bottom: var(--s-2);
  }

  .why {
    display: grid;
    gap: var(--s-5);
    align-items: center;
  }
  .why__photo {
    --tilt: -3deg;
    aspect-ratio: 4 / 3;
    max-width: 520px;
  }
  .why__copy h2 {
    max-width: 18ch;
  }
  .why__copy p {
    max-width: 60ch;
  }
  .facts {
    display: grid;
    gap: var(--s-2);
    margin: var(--s-4) 0;
    padding: var(--s-3) 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .facts__item {
    display: grid;
    gap: 2px;
  }
  .facts__num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 2rem;
    line-height: 1;
    color: var(--navy);
    letter-spacing: -0.02em;
  }
  .facts dd {
    margin: 0;
    color: var(--ink-600);
    font-size: var(--fs-small);
  }

  .bookband {
    display: grid;
    gap: var(--s-5);
    align-items: center;
  }
  .bookband__visual {
    position: relative;
    justify-self: center;
    width: min(100%, 300px);
  }
  .bookband__cover {
    position: relative;
    aspect-ratio: 2 / 3;
    display: grid;
    align-content: end;
    gap: var(--s-2);
    padding: var(--s-3);
    background: linear-gradient(160deg, var(--navy), var(--navy-700));
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-2);
    transform: rotate(-5deg);
  }
  .bookband__cover :global(.ph) {
    background: rgba(255, 255, 255, 0.92);
  }
  .bookband__cover-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.5rem;
    color: var(--paper);
    letter-spacing: -0.02em;
  }
  .bookband__obj {
    position: absolute;
    right: -30px;
    bottom: -20px;
    z-index: 2;
  }
  .bookband__copy p {
    max-width: 60ch;
  }
  .bookband__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    align-items: center;
    margin-top: var(--s-3);
  }
  .bookband__copy .small {
    margin-top: var(--s-1);
  }

  .latest {
    max-width: 820px;
  }
  .latest__more {
    margin-top: var(--s-3);
  }

  @media (min-width: 900px) {
    .why {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: var(--s-8);
    }
    .facts {
      grid-template-columns: repeat(3, 1fr);
    }
    .bookband {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: var(--s-8);
    }
    .bookband__visual {
      width: 320px;
    }
  }
</style>
