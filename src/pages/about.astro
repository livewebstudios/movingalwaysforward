---
// About Joe · five sections. No objects on this page; the photos do the work.
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';
import portrait from '../assets/photos/joe-portrait.png';
import ridge from '../assets/photos/joe-ridge-trail.png';
import SummitPhoto from '../components/SummitPhoto.astro';
import peak from '../assets/photos/summit-peak-corporate.jpg';

const title = 'About Joe Hliboki, Business & Career Coach | Always Forward Coaching';
const description =
  'Meet Joe Hliboki: Certified FocalPoint business, executive and career coach in Montvale, NJ. Former Cisco sales leader, author of Bursting the Bubble, early-career specialist.';
const path = '/about/';

const portraitImg = await getImage({ src: portrait, width: 800, format: 'jpg' });
const schema = [
  {
    '@type': 'Person',
    '@id': `${site.url}/#joe`,
    name: site.owner,
    givenName: 'Joe',
    familyName: 'Hliboki',
    jobTitle: site.jobTitle,
    description,
    image: new URL(portraitImg.src, site.url).href,
    url: `${site.url}${path}`,
    worksFor: { '@id': `${site.url}/#org` },
    address: { '@type': 'PostalAddress', addressLocality: 'Montvale', addressRegion: 'NJ', addressCountry: 'US' },
    alumniOf: { '@type': 'Organization', name: 'Cisco' },
    memberOf: { '@type': 'Organization', name: 'BNI Sunrise, Bergen County' },
    knowsAbout: ['Career coaching', 'Executive coaching', 'Sales training', 'Leadership development', 'Early-career development'],
    sameAs: [site.linkedin],
  },
];
---

<Base {title} {description} {path} crumbs={[{ name: 'About Joe', href: path }]} {schema} personOverride>
  <!-- 1. Hero -->
  <section class="ahero" aria-labelledby="about-title">
    <div class="container ahero__grid">
      <div class="ahero__copy" data-reveal-children>
        <p class="eyebrow">About</p>
        <h1 id="about-title">The coach who has actually done the job.</h1>
        <p class="lede">Joe Hliboki led sales teams at Cisco, mentored its best new hires, raised three kids through the Gen Z job market, and then made coaching his second career. Montvale, New Jersey.</p>
      </div>
      <div class="ahero__photo photo-card px-mid" data-reveal>
        <Image src={portrait} alt="Portrait of Joe Hliboki, business and career coach" widths={[420, 640, 860]} sizes="(max-width: 899px) 80vw, 420px" format="webp" quality={78} loading="eager" decoding="async" fetchpriority="high" />
      </div>
    </div>
  </section>

  <!-- 2. The story -->
  <Section tone="mist" pitch id="story" labelledby="story-title">
    <!-- the story on the left, the summit photo beside it with the flag level with the heading (Jon 26_11_11) -->
    <div class="summit-split">
    <div class="prose story" data-reveal-children>
      <h2 id="story-title">He's had your job. <span class="h-accent">That's why he can coach it.</span></h2>
      <p>
        Joe spent his corporate career at Cisco, where he led a healthcare sales team of sixteen to twenty people depending on the year. Hiring, promoting, coaching through slumps, managing up, hitting the target. The career questions he gets paid to answer now are ones he lived first, with a quota attached.
      </p>
      <p>
        Every year Cisco would hire a handful of new engineers, one in a hundred out of a hundred thousand applicants, train them in North Carolina, and let the best choose where to go. New York was always a top pick, so one would land on Joe's team. Brilliant on paper. Not yet people-smart. Joe became their mentor, and found he could get through to them fast.
      </p>
      <blockquote class="pullquote">
        &ldquo;Not every 62-year-old guy can talk to all these young people and connect with them in thirty minutes. You have something worth pursuing here.&rdquo;
        <cite>A mentor, watching Joe do it.</cite>
      </blockquote>
      <p>
        That was the crossroads. He was coaching executives at a client when the COO heard about his book and asked him to work with a few twenty-somethings on staff too. The leadership work paid in dollars. The early-career work paid in pennies. And Joe noticed that his preparation, his enthusiasm and the impact he was having all went up when the room got younger. He was good at both. He was built for one.
      </p>
      <p>
        Always Forward is what he did about it. Joe became a Certified FocalPoint Business, Executive & Career Coach, FocalPoint being the global coaching network whose curriculum backs his own experience with tested structure, and opened a practice with an unusual spread: Fortune-100-grade <a href="/corporate-training/">training for companies</a>, and <a href="/early-career-coaching/">$75 sessions</a> for kids six months out of college. He wrote <a href="/the-book/"><em>Bursting the Bubble: A Commonsense Guide to Early Career Success</em></a> so the advice would not be limited to the people in the room.
      </p>
      <p>
        The tagline is the job description. <strong>Working to facilitate change and accelerate success</strong>: change, because nothing he coaches works without it, and acceleration, because you would get there eventually. He just gets you there sooner.
      </p>
    </div>
      <SummitPhoto image={peak} summit={[49.9, 12.4]} contained crisp />
    </div>
  </Section>

  <!-- 3. Wide band -->
  <section class="ridge" aria-labelledby="ridge-title">
    <div class="ridge__media px-far" aria-hidden="true">
      <Image src={ridge} alt="" widths={[800, 1400, 2000]} sizes="100vw" format="webp" quality={70} loading="lazy" decoding="async" />
    </div>
    <div class="container ridge__inner">
      <div class="ridge__card card" data-reveal>
        <h2 id="ridge-title">Off the clock.</h2>
        <p>
          Joe lives in Montvale, New Jersey, with his wife and three kids, which means the Gen Z research program runs at home, nights and weekends. He has coached more than five hundred young athletes over the years. He is a member and officer of BNI Sunrise in Bergen County, where he is known for volunteering workshops nobody asked for and everybody attends. The family's long-range plan points toward the Connecticut shore, so Fairfield County clients: he is already looking your way.
        </p>
      </div>
    </div>
    <span class="sr-only">Joe Hliboki walking a ridge trail at sunrise with mist in the valley behind him</span>
  </section>

  <!-- 4. Credentials -->
  <Section id="credentials" labelledby="cred-title">
    <div class="sec-head" data-reveal>
      <h2 id="cred-title">The short <span class="h-accent">version.</span></h2>
    </div>
    <!-- grid-paper cards, three over two (Jon 26_11_11: same paper as the syllabus cards) -->
    <ol class="creds" data-reveal-children>
      <li class="cred">
        <span class="cred__num" aria-hidden="true">01</span>
        <h3 class="cred__title">Certified coach</h3>
        <p>FocalPoint Business, Executive & Career Coach.</p>
      </li>
      <li class="cred">
        <span class="cred__num" aria-hidden="true">02</span>
        <h3 class="cred__title">Cisco sales leader</h3>
        <p>Led a healthcare sales team of sixteen to twenty.</p>
      </li>
      <li class="cred">
        <span class="cred__num" aria-hidden="true">03</span>
        <h3 class="cred__title">Author</h3>
        <p><a href="/the-book/"><em>Bursting the Bubble</em></a>: A Commonsense Guide to Early Career Success.</p>
      </li>
      <li class="cred">
        <span class="cred__num" aria-hidden="true">04</span>
        <h3 class="cred__title">BNI Sunrise</h3>
        <p>Member and Power of One Coordinator, Bergen County, NJ.</p>
      </li>
      <li class="cred">
        <span class="cred__num" aria-hidden="true">05</span>
        <h3 class="cred__title">Three years coaching</h3>
        <p>Three delivery days a week, in person in northern NJ and by video nationally.</p>
      </li>
    </ol>
  </Section>

  <!-- 5. Closing CTA -->
  <CtaBand heading="Thirty minutes. See for yourself." body="The first call is free. Joe will tell you plainly whether coaching fits, and what to do tomorrow either way." button={{ label: 'Book a call with Joe', href: '/contact/' }} photo="summit-dawn" />
</Base>

<style>
  .ahero {
    padding-block: var(--s-4) var(--s-8);
  }
  .ahero__grid {
    display: grid;
    gap: var(--s-5);
    align-items: center;
  }
  .ahero__photo {
    --tilt: 3deg;
    width: min(80vw, 420px);
    aspect-ratio: 3 / 4;
    justify-self: center;
  }
  .story p {
    font-size: 1.0625rem;
  }
  .ridge {
    position: relative;
    overflow: hidden;
    min-height: 480px;
    display: flex;
    align-items: center;
    padding-block: var(--s-8);
    background: var(--navy);
  }
  .ridge__media {
    position: absolute;
    inset: -10% 0;
  }
  .ridge__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ridge__inner {
    position: relative;
    z-index: 1;
  }
  .ridge__card {
    max-width: 520px;
    padding: var(--s-4);
  }
  .ridge__card h2 {
    margin-bottom: var(--s-2);
  }
  .creds {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-3);
  }
  /* same grid paper as the syllabus cards (--grid-paper-* tokens) */
  .cred {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: var(--s-4);
    border: 1px solid rgba(6, 26, 58, 0.1);
    border-radius: var(--r-xl);
    background: var(--grid-paper-bg);
    box-shadow: var(--shadow-1);
  }
  .cred::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(var(--grid-paper-major) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-paper-major) 1px, transparent 1px),
      linear-gradient(var(--grid-paper-minor) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-paper-minor) 1px, transparent 1px);
    background-size: 60px 60px, 60px 60px, 12px 12px, 12px 12px;
    background-position: -1px -1px;
    -webkit-mask-image: var(--grid-paper-mask);
    mask-image: var(--grid-paper-mask);
    pointer-events: none;
  }
  .cred__num {
    margin-bottom: var(--s-2);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 2.75rem;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--sky);
  }
  .cred__title {
    margin: 0 0 6px;
    font-size: var(--fs-h3);
    color: var(--navy);
  }
  .cred p {
    margin: 0;
    color: var(--ink);
    max-width: 52ch;
  }
  @media (min-width: 720px) {
    .creds {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
    .cred {
      grid-column: span 2;
    }
    .cred:nth-child(n + 4) {
      grid-column: span 3;
    }
  }
  @media (min-width: 900px) {
    .ahero {
      min-height: 60vh;
      display: flex;
      align-items: center;
    }
    .ahero__grid {
      grid-template-columns: minmax(0, 1.2fr) 420px;
      gap: var(--s-8);
    }
    .ridge {
      min-height: 560px;
    }
  }
</style>
