---
// Career Steppingstones · the paid program from Joe's flyer. Driven by src/data/steppingstones.ts.
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import InteriorHero from '../components/InteriorHero.astro';
import CtaBand from '../components/CtaBand.astro';
import PricingStones from '../islands/PricingStones';
import { getImage } from 'astro:assets';
import markPng from '../assets/brand/logo-mark-2x.png';
import Backdrop from '../components/Backdrop.astro';
import Obj from '../components/Obj.astro';
import Button from '../components/Button.astro';
import Placeholder from '../components/Placeholder.astro';
import SummitPhoto from '../components/SummitPhoto.astro';
import peak from '../assets/photos/summit-peak-exec.jpg';
import sideline from '../assets/photos/football-sideline.jpg';
import { stoneCards, tracks, flyers, pricing } from '../data/steppingstones';
import { site } from '../data/site';
import bgLight from '../assets/backgrounds/bg-contour-light.png';
import { Image } from 'astro:assets';
import bgMindset from '../assets/steppingstones/mindset.webp';
import bgWorth from '../assets/steppingstones/know-your-worth.webp';
import bgSearch from '../assets/steppingstones/win-the-search.webp';
import bgYourself from '../assets/steppingstones/know-yourself.webp';
import bgRoom from '../assets/steppingstones/read-the-room.webp';
import bgHabits from '../assets/steppingstones/build-the-habits.webp';

// Soothing dark photo behind each topic cluster card, keyed by cluster name.
const clusterBg: Record<string, ImageMetadata> = {
  Mindset: bgMindset,
  'Know your worth': bgWorth,
  'Win the search': bgSearch,
  'Know yourself': bgYourself,
  'Read the room': bgRoom,
  'Build the habits': bgHabits,
};

const mark = await getImage({ src: markPng, width: 40 });

const title = 'Career Steppingstones: Virtual Career Growth Program | Always Forward Coaching';
const description =
  'Career Steppingstones is Joe Hliboki’s virtual career growth program for young professionals: small-group workshops, a peer Coffee Club, weekly accountability. $99 a month.';
const path = '/career-steppingstones/';

const schema = [
  {
    '@type': 'Course',
    name: 'Career Steppingstones: A Virtual Career Growth Program',
    description,
    url: `${site.url}${path}`,
    provider: { '@id': `${site.url}/#org` },
    courseMode: 'Online',
    educationalLevel: 'Early career',
    hasCourseInstance: {
      '@type': 'CourseInstance',
      courseMode: 'Online',
      courseWorkload: 'PT2H',
      instructor: { '@id': `${site.url}/#joe` },
    },
    offers: [
      { '@type': 'Offer', name: pricing.initiation.label, price: pricing.initiation.price, priceCurrency: 'USD', category: 'Initiation', availability: 'https://schema.org/InStock', url: `${site.url}${path}` },
      { '@type': 'Offer', name: pricing.monthly.label, price: pricing.monthly.price, priceCurrency: 'USD', category: 'Subscription', availability: 'https://schema.org/InStock', url: `${site.url}${path}` },
      { '@type': 'Offer', name: pricing.yearly.label, price: pricing.yearly.price, priceCurrency: 'USD', category: 'Subscription', availability: 'https://schema.org/InStock', url: `${site.url}${path}` },
    ],
  },
];
---

<Base {title} {description} {path} crumbs={[{ name: 'Career Steppingstones', href: path }]} {schema}>
  <InteriorHero
    eyebrow="Career Steppingstones"
    title="One stone at a time. Always forward."
    deck="&ldquo;Hire me so you can get the job, and fire me. That is my success.&rdquo;"
    deckSerif
    body="A virtual career growth program for aspiring young professionals: two small-group workshops a month, a peer Coffee Club, and a coach in your corner for $99 a month. Cancel whenever, hopefully because you got the job."
    button={{ label: 'Start with a free call', href: '/contact/' }}
    object="stepping-stones"
    objectSize={280}
    objectRotate={-8}
  />

  <!-- 2. Who it is for -->
  <Section tone="mist" pitch id="who" labelledby="who-title">
    <div class="summit-split">
    <div class="prose who__copy" data-reveal-children>
      <h2 id="who-title">For the ones lacking a map, <span class="h-accent">not ability.</span></h2>
      <p>
        About to graduate. Just graduated. Unemployed or underemployed and tired of it. Stuck, without focus, vision or direction. Or already working and wanting the next level and to get better at what you do. Joe built this because the one-on-one coaching works, and not every 23-year-old can afford it. This is the same material at a price a first paycheck can carry.
      </p>
      <blockquote class="pullquote">
        To share awareness, insight, strategy and experience that produce confidence and a competitive career advantage that attracts hiring managers.
        <cite>The program's purpose, in Joe's words</cite>
      </blockquote>
    </div>
      <SummitPhoto image={peak} summit={[54.9, 12.9]} contained crisp shift="clamp(0px, (100vw - 1100px) * 0.5, 200px)" />
    </div>
  </Section>

  <!-- 3. What is in the program -->
  <section class="stones-wrap" id="program" aria-labelledby="program-title">
    <Backdrop image={bgLight} class="stones-bg" />
    <div class="container stones-inner">
      <PricingStones
        client:load
        cards={stoneCards}
        mark={{ src: mark.src, width: 20, height: 18 }}
        words={['What', 'you', 'get.']}
        sub="Start once at $199, then month to month. Pay for the year and save 20%."
        titleId="program-title"
      />
    </div>
  </section>

  <!-- 4. The two tracks: six topic clusters, three per track (data in src/data/steppingstones.ts) -->
  <Section tone="mist" id="tracks" labelledby="tracks-title">
    <div class="sec-head" data-reveal-children>
      <h2 id="tracks-title">Two tracks. <span class="h-accent">Twenty-two topics.</span></h2>
      <p class="deck">Each month brings one workshop from each track. One gets you hired. The other gets you better once you are there.</p>
    </div>
    <div class="tracks">
      {
        tracks.map((t, i) => (
          <div class="track" role="group" aria-labelledby={`track-${i}`} data-reveal-children>
            <div class="track__head">
              <p class="track__name" id={`track-${i}`}>{t.name}</p>
              <p class="track__tagline">{t.tagline}</p>
            </div>
            {t.clusters.map((c) => (
              <div class="cluster">
                {clusterBg[c.name] && (
                  <Image class="cluster__bg" src={clusterBg[c.name]} widths={[600, 1000]} sizes="(min-width: 768px) 50vw, 100vw" format="webp" quality={70} alt="" aria-hidden="true" loading="lazy" decoding="async" />
                )}
                <h3 class="cluster__name">{c.name}</h3>
                <ul class="cluster__list">
                  {c.topics.map((topic) => <li>{topic}</li>)}
                </ul>
              </div>
            ))}
          </div>
        ))
      }
    </div>
  </Section>

  <!-- 5. Proof and the flyer library -->
  <Section pitch id="proof" labelledby="proof-title">
    <!-- 50/50 card: high school football practice, a coach on the side (no Joe, no faces) left, copy right (shared .split-card in global.css) -->
    <div class="split-card card coach-card" data-reveal>
      <div class="split-card__media">
        <Image src={sideline} alt="High school football players running a handoff drill at practice while a coach watches from the side" widths={[480, 720, 960, 1280]} sizes="(min-width: 900px) 50vw, 100vw" format="webp" quality={78} loading="lazy" decoding="async" style="--split-pos: 40% 50%" />
      </div>
      <div class="split-card__copy prose">
      <h2 id="proof-title">From the coach who <span class="h-accent">wrote the book.</span></h2>
      <p>
        Joe Hliboki is a Certified Business, Executive & Career Coach who helps people get better at what they do and solve the problems they have not been able to solve alone. He is connected to Gen Z through his own three kids, through coaching more than five hundred young athletes as they grew up, and through mentoring new hires inside a Fortune 100. <a href="/the-book/"><em>Bursting the Bubble</em></a> is the textbook; this program is the class. The same material, one-on-one, is <a href="/early-career-coaching/">Early Career Coaching</a>.
      </p>
      </div>
    </div>

    <div class="flyers" data-reveal-children>
      <h3 class="flyers__heading">Program flyers.</h3>
      <ul class="flyers__grid">
        {
          flyers.map((f) => (
            <li class="flyer card">
              <svg class="flyer__icon" aria-hidden="true" viewBox="0 0 32 32" width="32" height="32" fill="none" stroke="#54A4E2" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3h10l6 6v20H9z M19 3v6h6 M12 17h8 M12 22h8" /></svg>
              <h4 class="flyer__title">{f.title}</h4>
              <p class="small">{f.description}</p>
              {f.file ? <a href={f.file} class="flyer__link" download>Download the PDF</a> : <Placeholder text={f.placeholder ?? 'PDF PLACEHOLDER'} />}
            </li>
          ))
        }
      </ul>
      <p class="small flyers__note">More flyers get added as Joe produces them.</p>
    </div>

    <form class="capture card" action={site.formspree} method="POST" data-reveal aria-labelledby="capture-title">
      <div class="capture__obj">
        <Obj name="paper-plane" size={80} sizeMobile={64} rotate={-14} float phase={6} />
      </div>
      <h3 id="capture-title">New stones drop regularly. Want them as they land?</h3>
      <div class="capture__row">
        <div class="field">
          <label for="ss-email">Email</label>
          <input id="ss-email" type="email" name="email" autocomplete="email" required placeholder="you@example.com" />
        </div>
        <input type="text" name="_gotcha" class="sr-only" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <input type="hidden" name="_subject" value="Always Forward website: Steppingstones list" />
        <Button type="submit">Send me the next one</Button>
      </div>
    </form>
  </Section>

  <!-- 6. Closing CTA -->
  <CtaBand
    heading="Thirty minutes with Coach Joe. Then decide."
    body="The introductory call is included in the initiation, and it is also free if you just want to ask questions first."
    button={{ label: 'Book the call', href: '/contact/' }}
    photo="summit-clouds"
  />
</Base>

<style>
  .stones-wrap {
    position: relative;
    overflow: hidden;
    padding-block: var(--section-y);
    background: var(--paper);
  }
  .stones-wrap :global(.stones-bg) {
    opacity: 0.5;
  }
  .stones-inner {
    position: relative;
    z-index: 1;
  }
  .tracks {
    display: grid;
    gap: var(--s-5);
  }
  .track {
    display: grid;
    gap: var(--s-3);
    align-content: start;
  }
  /* Cluster cards float up into place, hinged at the bottom edge (after the Aceternity
     inference-page panel: 80px low, tipped back 28deg, springing flat with a small overshoot).
     Rides the section reveal, so the 80ms stagger comes from the global nth-child delays. */
  .track[data-reveal-children] {
    perspective: 1800px;
  }
  :global(.js) .track[data-reveal-children] > .cluster {
    opacity: 0;
    transform: translateY(80px) rotateX(28deg);
    transform-origin: 50% 100%;
    backface-visibility: hidden;
    transition:
      opacity 600ms var(--ease-out),
      transform 1100ms cubic-bezier(0.2, 1.25, 0.35, 1);
  }
  :global(.js) .track[data-reveal-children].is-in > .cluster {
    opacity: 1;
    transform: none;
  }
  :global(.js) .track[data-reveal-children].is-in > .cluster:nth-child(2) {
    transition-delay: 80ms;
  }
  :global(.js) .track[data-reveal-children].is-in > .cluster:nth-child(3) {
    transition-delay: 160ms;
  }
  :global(.js) .track[data-reveal-children].is-in > .cluster:nth-child(4) {
    transition-delay: 240ms;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .track[data-reveal-children] > .cluster {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
  .track__name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-h3);
    line-height: 1.2;
    color: var(--navy);
  }
  .track__tagline {
    margin: 4px 0 0;
    color: var(--ink-600);
  }
  /* Dark photo cards: soothing night image, navy wash for contrast, white type. */
  .cluster {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--navy);
    border-radius: var(--r-lg);
    box-shadow: 0 2px 4px rgba(6, 26, 58, 0.12), 0 14px 32px rgba(6, 26, 58, 0.18);
    padding: var(--s-4);
    color: #fff;
  }
  .cluster :global(.cluster__bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  .cluster::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(100deg, rgba(6, 26, 58, 0.72) 0%, rgba(6, 26, 58, 0.42) 55%, rgba(6, 26, 58, 0.12) 100%);
  }
  .cluster__name {
    font-size: 1.25rem;
    margin: 0 0 var(--s-2);
    color: #fff;
  }
  .cluster__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .cluster__list li {
    position: relative;
    padding-left: 22px;
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.92);
  }
  /* the stone: a small flattened sky oval, tipped like a stepping stone */
  .cluster__list li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.58em;
    width: 9px;
    height: 6px;
    border-radius: 50%;
    background: var(--sky);
    transform: rotate(-12deg);
  }
  .flyers {
    margin-top: var(--s-5);
    max-width: 760px;
  }
  .flyers__heading {
    margin-bottom: var(--s-2);
  }
  .flyers__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-2);
  }
  .flyer {
    display: grid;
    gap: 8px;
    justify-items: start;
  }
  .flyer__title {
    font-size: 1.0625rem;
    margin: 0;
  }
  .flyer__link {
    font-weight: 600;
  }
  .flyers__note {
    margin-top: var(--s-2);
  }
  .capture {
    position: relative;
    margin-top: var(--s-5);
    max-width: 760px;
    padding-top: var(--s-5);
  }
  .capture__obj {
    position: absolute;
    top: -26px;
    right: var(--s-2);
  }
  .capture h3 {
    max-width: 22ch;
    margin-right: 72px;
  }
  .capture__row {
    display: grid;
    gap: var(--s-2);
    align-items: end;
  }
  .capture__row .field {
    margin: 0;
  }
  @media (min-width: 768px) {
    .tracks {
      grid-template-columns: 1fr 1fr;
      gap: var(--s-4);
    }
    .flyers__grid {
      grid-template-columns: 1fr 1fr;
    }
    .capture__row {
      grid-template-columns: 1fr auto;
    }
  }
  /* 2. Who: the copy sits above the summit photo, which reaches left to touch it (Jon 26_11_11) */
  .who__copy {
    position: relative;
    z-index: 1;
  }
</style>
